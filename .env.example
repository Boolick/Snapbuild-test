# ==============================================================================
# AI Image Workflow - Environment Variables Configuration
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI Provider Selection: auto | gemini | openai | stability | replicate | mock
# 'auto' will automatically pick the first available provider with a configured API key.
# If no keys are provided, it safely falls back to 'mock' (offline generator).
AI_PROVIDER=auto

# --- AI Provider API Keys (Fill the one you want to use) ---

# 1. Google Gemini (Imagen / Gemini Pro)
GEMINI_API_KEY=

# 2. OpenAI (DALL-E 3)
OPENAI_API_KEY=

# 3. Stability AI (Stable Diffusion 3 / Ultra)
STABILITY_API_KEY=

# 4. Replicate (FLUX.1, SDXL)
REPLICATE_API_TOKEN=

# Simulated delay in milliseconds when using the Mock provider
MOCK_AI_DELAY_MS=1500
