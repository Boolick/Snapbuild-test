{
  "name": "snapbuild-ai-image-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "AI Image Workflow Mini - Node-based visual graph editor with parallel execution and strict NestJS backend",
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix Frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix Frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend run test",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix Frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format:backend": "npm --prefix backend run format",
    "format:frontend": "npm --prefix Frontend run format",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "install:all": "npm --prefix backend install && npm --prefix Frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "fsd",
    "nestjs",
    "react-flow",
    "ai-workflow",
    "dag-execution",
    "parallel-execution",
    "sse"
  ],
  "author": "Fullstack AI Engineer",
  "license": "MIT"
}
