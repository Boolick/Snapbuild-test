# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Whitelist (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI Provider Configuration ('mock' | 'openai' | 'stability' | 'replicate')
AI_PROVIDER=mock

# External AI Provider API Keys (Keep server-side only!)
OPENAI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# Simulation delay for Mock AI Provider (in milliseconds)
MOCK_AI_DELAY_MS=1500
