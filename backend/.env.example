# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Whitelist (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI Provider Configuration ('auto' | 'gemini' | 'openai' | 'stability' | 'replicate' | 'mock')
# In 'auto' mode (default), the server automatically detects whichever API key you provide!
AI_PROVIDER=auto

# External AI Provider API Keys (Server-side only)
# Google Gemini / Imagen 3 (Google AI Studio Key):
GEMINI_API_KEY=

# OpenAI DALL-E 3:
OPENAI_API_KEY=

# Stability AI:
STABILITY_API_KEY=

# Replicate API:
REPLICATE_API_TOKEN=

# Simulation delay for Mock AI Provider (in milliseconds, used if no keys are provided)
MOCK_AI_DELAY_MS=1500
